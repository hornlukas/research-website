---
import { profile } from '../../settings'

const { fullName } = profile
---

<footer class='footer footer-center bg-base-100 text-base-content px-4 py-8'>
	<nav class="flex gap-4 justify-center mb-2">
        <a href="/imprint" class="link link-hover">Imprint</a>
        <a href="/privacy" class="link link-hover">Privacy Policy</a>
    </nav>
	<aside>
		<p>
			Copyright © {new Date().getFullYear()} - All right reserved by {fullName}
		</p>
		<p>
			Built with <a
				href='https://github.com/maiobarbero/astro_academia'
				class='font-bold'
				target='_blank'>Astro Academia</a
			> 🎓 by <a
				href='http://maiobarbero.dev'
        class="font-bold"
				target='_blank'>Matteo Barbero</a>
		</p>
	</aside>
</footer>
